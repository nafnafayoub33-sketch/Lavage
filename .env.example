# Copy to .env and fill in. `.env` is gitignored — never commit real keys.
#
# Both values come from the Supabase dashboard:
#   Project settings -> API
#
# EXPO_PUBLIC_ vars are inlined into the app bundle at build time, so treat
# them as public. That is fine for the anon key: access is controlled by row
# level security policies, not by keeping this key secret. The service_role
# key must never appear here or anywhere in the client.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
