# Copy to .env and fill in. `.env` is gitignored — never commit real keys.
#
# Both values come from the Supabase dashboard:
#   Project settings -> API
#
# EXPO_PUBLIC_ vars are inlined into the app bundle at build time, so treat
# them as public. That is fine for the anon key: access is controlled by row
# level security policies, not by keeping this key secret. The service_role
# key must never appear here or anywhere in the client.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Google Maps SDK for Android — C1's map.
#
# Android has no built-in map provider: without this the map is a blank
# rectangle and the build says nothing. iOS uses Apple Maps and needs no key.
#
# This one is NOT prefixed EXPO_PUBLIC_. app.config.ts reads it at config time
# and bakes it into the native manifest rather than the JS bundle. It still
# ships inside the APK, so restrict it by package name + SHA-1 in the Google
# Cloud console — restriction is what protects it, not secrecy.
#
# Changing it requires a new native build; a JS reload will not pick it up.
GOOGLE_MAPS_ANDROID_API_KEY=
